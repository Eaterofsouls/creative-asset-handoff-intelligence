# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already listed in .gitignore).

# Required only for LIVE AI analysis (docs/architecture-decision.md §4, §10).
# Without this set, the pipeline automatically runs in a clearly-labeled
# offline mock mode -- nothing fails, nothing pretends to be a real model call.
ANTHROPIC_API_KEY=

# Optional: override the default vision model used for AI cluster analysis.
# See docs/model-selection.md.
# ANTHROPIC_MODEL=claude-sonnet-4-6
